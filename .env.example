# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Auth
JWT_SECRET=

# Email OTP
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Stripe — use TEST keys locally (pk_test_ / sk_test_)
# For LIVE checkout on production, set pk_live_ / sk_live_ in Vercel
# (Dashboard → Developers → API keys, toggle Live mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
# Webhook: Stripe Dashboard → Developers → Webhooks → Add endpoint
# URL: https://YOUR_DOMAIN/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
